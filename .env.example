# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha o que for usar.
# O `.env` está no .gitignore e NUNCA deve ir para o repositório.
# ---------------------------------------------------------------------------

# Diretório onde o Fluxor procura os arquivos .yaml de workflow
FLUXOR_WORKFLOWS_DIR=./examples

# Banco de execuções (SQLite por padrão; aceita Postgres async também)
FLUXOR_DATABASE_URL=sqlite+aiosqlite:///./fluxor.db

# Servidor da API/dashboard
FLUXOR_HOST=127.0.0.1
FLUXOR_PORT=8000

# text = legível para humanos | json = pronto para Datadog/Loki/CloudWatch
FLUXOR_LOG_FORMAT=text
FLUXOR_LOG_LEVEL=INFO

# Fuso usado pelo agendador quando o workflow não define o seu
FLUXOR_TIMEZONE=America/Sao_Paulo

# Sobe o agendador junto com a API (`fluxor serve`)
FLUXOR_ENABLE_SCHEDULER=false

# --- Credenciais usadas pelos workflows de exemplo -------------------------
# Só ficam visíveis para o workflow que declarar o nome na chave `env:`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GITHUB_TOKEN=
